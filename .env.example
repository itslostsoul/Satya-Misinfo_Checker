# Used by backend/card_renderer.py and backend/pipelines/text_pipeline.py
# (LLM for claim extraction, verdict writing, translated card text)
# Free tier: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# Used by backend/pipelines/image_pipeline.py — reverse image search
# (https://serpapi.com — free tier: 100 searches/mo)
SERPAPI_API_KEY=your_serpapi_key

# Used by backend/pipelines/text_pipeline.py — fact-check source lookup
# via Google's Fact Check Tools API
GOOGLE_FACT_CHECK_KEY=your_google_fact_check_key
